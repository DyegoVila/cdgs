DELIMITER $$

CREATE TRIGGER tgRgistra
AFTER UPDATE ON tbproduto
FOR EACH ROW
BEGIN
    IF.OLD.VaProduto <> NEW.VaProduto THEN
      INSERT INTO Tblog (TxLog)
      VALUES (
          CONCAT (
              'o produto', NEW.NoProduto,
              ' mudou de R$', FORMAT(OLD.VaProduto, 2),
              ' para R$', FORMAT(NEW.VaProduto, 2), '.'
                )
              );
          END IF;
END$$

DELIMITER;
      
#Stored Procedure

DELIMITER $$

CREATE PROCEDURE spProdutoAltera (
    IN p_CoProduto SMALLINT,
    IN p_NoProduto VARCHAR(50),
    IN p_VaProduto DECIMAL(7,2),
    IN p_QtEstoque SMALLINT
)
BEGIN
    UPDATE TbProduto
    SET
        NoProduto = p_NoProduto,
        VaProduto = p_VaProduto,
        QtEstoque = p_QtEstoque
    WHERE
        CoProduto = p_CoProduto;
END$$

DELIMITER ;
